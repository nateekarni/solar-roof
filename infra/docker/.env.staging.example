# Copy values into Coolify environment settings. Never commit real credentials.
WEB_IMAGE=ghcr.io/nateekarni/solar-roof/web@sha256:REPLACE_WITH_CI_DIGEST
API_IMAGE=ghcr.io/nateekarni/solar-roof/api@sha256:REPLACE_WITH_CI_DIGEST
WORKER_IMAGE=ghcr.io/nateekarni/solar-roof/worker@sha256:REPLACE_WITH_CI_DIGEST
MQTT_IMAGE=ghcr.io/nateekarni/solar-roof/mqtt@sha256:REPLACE_WITH_CI_DIGEST
CERTBOT_IMAGE=ghcr.io/nateekarni/solar-roof/certbot@sha256:REPLACE_WITH_CI_DIGEST
POSTGRES_IMAGE=ghcr.io/nateekarni/solar-roof/postgres-backup@sha256:REPLACE_WITH_CI_DIGEST
POSTGRES_DB=solar_platform
POSTGRES_USER=solar
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
# Percent-encode reserved characters in the password for this URL.
DATABASE_URL=postgresql://solar:REPLACE_WITH_URL_ENCODED_SECRET@postgres:5432/solar_platform
JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_32_RANDOM_CHARACTERS
# Deployment gate: keep false/empty until the actual Coolify chain is inspected.
# Use only exact ingress proxy CIDRs, never an entire application/container network.
# Confirm API is attached to this proxy network and generated web router priority <100.
API_EDGE_ENABLED=false
TRUSTED_PROXY_CIDRS=
COOLIFY_PROXY_NETWORK=coolify
COOLIFY_HTTPS_ENTRYPOINT=https
COOLIFY_CERT_RESOLVER=letsencrypt
MQTT_PASSWORD=REPLACE_WITH_SOLAR_BACKEND_PASSWORD
MQTT_ENABLED=true
MQTT_DEFAULT_BROKER_ENABLED=true
# Each gateway name must equal its username; credentials are never shared with backend.
MQTT_GATEWAY_CREDENTIALS={"pilot-01":"REPLACE_WITH_DIFFERENT_RANDOM_PASSWORD"}
CLOUDFLARE_API_TOKEN=REPLACE_WITH_ZONE_DNS_EDIT_TOKEN_FOR_FOWIR_COM
ACME_EMAIL=REPLACE_WITH_YOUR_REAL_EMAIL
BOOTSTRAP_ADMIN_EMAIL=REPLACE_WITH_YOUR_ADMIN_EMAIL
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_16_RANDOM_CHARACTERS
MINIO_ROOT_USER=solar
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_SECRET
STORAGE_REGION=us-east-1
STORAGE_BUCKET=solar-platform

# Flag alone cannot enable writes: verified F2 accounting/workflow evidence is required.
FINANCIAL_WRITES_ENABLED=false

# Proposed Q2 budgets: firmware payload/rate compatibility and B2 capacity gates remain required before pilot.
MQTT_MAX_PAYLOAD_BYTES=131072
MQTT_MAX_JSON_DEPTH=16
INGEST_CONCURRENCY=2
INGEST_QUEUE_LIMIT=1024
INGEST_QUEUE_BYTES=16777216
INGEST_PER_GATEWAY_RATE=50
INGEST_PER_GATEWAY_BURST=100
INGEST_SHUTDOWN_TIMEOUT_MS=10000
API_READ_POOL_MAX=4
INGEST_DB_POOL_MAX=2
API_READ_STATEMENT_TIMEOUT_MS=1500
INGEST_DB_STATEMENT_TIMEOUT_MS=5000

# Keep disabled until checkpointed backfill and full requested-range coverage are verified.
ENERGY_READ_MODEL_ENABLED=false
ENERGY_SUMMARY_WORKER_ENABLED=false
REPORT_WORKER_ENABLED=false
# เปิด API และ worker คู่กันหลังตรวจ archive coverage และทรัพยากรแล้ว
HISTORY_RESTORE_ENABLED=false
HISTORY_RESTORE_WORKER_ENABLED=false
TELEMETRY_ARCHIVE_ENABLED=false
TELEMETRY_ARCHIVE_SCHEDULER_ENABLED=false
# ยังไม่มีการลบ raw แม้เปลี่ยน flag นี้ ต้องผ่านหลักฐาน retention ก่อน
RAW_RETENTION_ENABLED=false
HISTORY_RESTORE_MAX_DAYS=31
HISTORY_RESTORE_MAX_ROWS=1000000
HISTORY_RESTORE_MAX_MANIFESTS=1000
HISTORY_RESTORE_MAX_COMPRESSED_BYTES=536870912
HISTORY_RESTORE_MAX_UNCOMPRESSED_BYTES=2147483648
HISTORY_RESTORE_TIMEOUT_MS=600000

# เปิดเมื่อทดสอบปลายทาง backup นอกเครื่องแล้วเท่านั้น
BACKUP_ENABLED=false
PGBACKREST_REPO1_S3_ENDPOINT=
PGBACKREST_REPO1_S3_BUCKET=
PGBACKREST_REPO1_S3_REGION=
PGBACKREST_REPO1_S3_KEY=
PGBACKREST_REPO1_S3_KEY_SECRET=
PGBACKREST_REPO1_CIPHER_PASS=
PGBACKREST_REPO1_PATH=/solar

# ตรวจการรับ webhook ด้วยปลายทางทดสอบก่อนเปิดส่งจริง
PLATFORM_MONITORING_ENABLED=false
PLATFORM_MONITORING_RECEIVER_VERIFIED=false
PLATFORM_MONITORING_WEBHOOK_URL=
PLATFORM_MONITORING_WEBHOOK_TOKEN=
PLATFORM_WAL_LAG_SECONDS=600
PLATFORM_BACKUP_AGE_SECONDS=93600
PLATFORM_DISK_PERCENT=80
PLATFORM_RELEASE_REVISION=
PLATFORM_IMAGE_DIGESTS_JSON=
PLATFORM_RELEASE_EVIDENCE_JSON=

# ใช้เฉพาะ resource สำรอง/กู้ไฟล์ ไม่ส่ง credentials ชุดนี้ไป API/web
DR_ARTIFACT_BACKUP_ENABLED=false
DR_ARTIFACT_BACKUP_INTERVAL_SECONDS=300
DR_ARTIFACT_BACKUP_TIMEOUT_SECONDS=300
DR_DOCUMENTS_ENDPOINT=
DR_DOCUMENTS_REGION=
DR_DOCUMENTS_BUCKET=
DR_DOCUMENTS_ACCESS_KEY=
DR_DOCUMENTS_SECRET_KEY=
DR_REPOSITORY_ENDPOINT=
DR_REPOSITORY_REGION=
DR_REPOSITORY_BUCKET=
DR_REPOSITORY_ACCESS_KEY=
DR_REPOSITORY_SECRET_KEY=
DR_ARTIFACT_CIPHER_PASS=
DR_CONFIG_EXPORT_FILE=
DR_ARTIFACT_MANIFEST_KEY=
DR_CONFIG_RESTORED_FILE=
DR_REQUIRED_INVENTORY_FILE=

# Pilot resource ceilings for 2 vCPU / 4 GiB. CPU limits do not reserve cores.
POSTGRES_CPU_LIMIT=0.75
POSTGRES_MEMORY_LIMIT=768m
POSTGRES_MEMORY_RESERVATION=256m
REDIS_CPU_LIMIT=0.25
REDIS_MEMORY_LIMIT=128m
REDIS_MEMORY_RESERVATION=32m
CERTBOT_CPU_LIMIT=0.25
CERTBOT_MEMORY_LIMIT=128m
CERTBOT_MEMORY_RESERVATION=32m
MQTT_CPU_LIMIT=0.25
MQTT_MEMORY_LIMIT=128m
MQTT_MEMORY_RESERVATION=32m
STORAGE_CPU_LIMIT=0.25
STORAGE_MEMORY_LIMIT=256m
STORAGE_MEMORY_RESERVATION=64m
STORAGE_INIT_CPU_LIMIT=0.25
STORAGE_INIT_MEMORY_LIMIT=128m
MIGRATE_CPU_LIMIT=0.50
MIGRATE_MEMORY_LIMIT=256m
BOOTSTRAP_CPU_LIMIT=0.25
BOOTSTRAP_MEMORY_LIMIT=128m
RELEASE_EVIDENCE_CPU_LIMIT=0.25
RELEASE_EVIDENCE_MEMORY_LIMIT=128m
API_CPU_LIMIT=0.75
API_MEMORY_LIMIT=512m
API_MEMORY_RESERVATION=256m
WORKER_CPU_LIMIT=0.25
WORKER_MEMORY_LIMIT=256m
WORKER_MEMORY_RESERVATION=64m
WEB_CPU_LIMIT=0.50
WEB_MEMORY_LIMIT=384m
WEB_MEMORY_RESERVATION=128m


# Optional, one-time user-only pilot seed. Does not run automatically.
PILOT_USERS_ENABLED=false
PILOT_SCHOOL_ID=
PILOT_ADMIN_EMAIL=
PILOT_ADMIN_PASSWORD=
PILOT_OWNER_EMAIL=
PILOT_OWNER_PASSWORD=
PILOT_SCHOOL_EMAIL=
PILOT_SCHOOL_PASSWORD=
