# Standalone broker resource with host-managed TLS certificates; copy to Coolify, replace placeholders.
MQTT_IMAGE=ghcr.io/nateekarni/solar-roof/mqtt@sha256:REPLACE_WITH_CI_DIGEST
MQTT_PASSWORD=REPLACE_WITH_BACKEND_PASSWORD_AT_LEAST_16_CHARACTERS
# Username equals Gateway ID for solar/v1 topics (GW-001); legacy energy topics use username too.
MQTT_GATEWAY_CREDENTIALS={"GW-001":"REPLACE_WITH_DIFFERENT_GATEWAY_PASSWORD"}
# Directory on host containing fullchain.pem and privkey.pem
MQTT_CERTS_DIR=/data/mqtt-certs
MQTT_TLS_DOMAIN=mqtt-solar.fowir.com
MQTT_CPU_LIMIT=0.25
MQTT_MEMORY_LIMIT=128m
MQTT_MEMORY_RESERVATION=32m
