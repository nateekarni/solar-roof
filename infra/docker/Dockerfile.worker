# Keep Node and pnpm aligned with the root package.json engines/packageManager.
FROM node:24.20.0-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /app
RUN npm install --global pnpm@11.24.0

FROM base AS build
# All workspace packages are required for frozen-lockfile resolution and TS paths.
# .dockerignore excludes local env files, credentials, build output and dependencies.
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @solar/worker... --recursive build

FROM base AS runtime
ENV NODE_ENV=production
RUN groupadd --system app && useradd --system --gid app app
COPY --from=build --chown=app:app /app /app
USER app
WORKDIR /app/apps/worker
EXPOSE 3002
CMD ["node", "--import", "tsx", "src/main.ts"]
