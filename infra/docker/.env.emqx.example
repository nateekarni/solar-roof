# Standalone EMQX 5.8.3 resource; copy to Coolify and replace every placeholder.
# Use hex secrets so EMQX/HOCON does not reinterpret punctuation.
EMQX_NODE_COOKIE=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
EMQX_DASHBOARD_USER=REPLACE_WITH_NON_DEFAULT_OPERATOR_USERNAME
EMQX_DASHBOARD_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
INTERNAL_MQTT_SECRET=REPLACE_WITH_DIFFERENT_64_RANDOM_HEX_CHARACTERS
