# Standalone EMQX Broker with Dynamic Webhook Auth; copy to Coolify resource
EMQX_IMAGE=emqx/emqx:5.8.3
# Directory on host containing fullchain.pem and privkey.pem
MQTT_CERTS_DIR=/data/mqtt-certs
# Optional Dashboard admin credentials (port 18083)
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
