{
  "name": "@solar/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/main.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --tsconfig tsconfig.json --test src/**/*.spec.ts",
    "db:migrate": "tsx src/scripts/db-migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:seed:reset": "tsx src/scripts/seed.ts --reset",
    "simulate:mqtt": "tsx src/scripts/simulate-mqtt.ts",
    "test:ingestion": "tsx src/scripts/test-gateway-ingestion.ts",
    "test:payload-gateway": "tsx src/scripts/verify-payload-gateway.ts",
    "db:bootstrap": "tsx src/scripts/bootstrap-staging.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/terminus": "^11.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/client": "^7.10.0",
    "@solar/api-contracts": "workspace:*",
    "@solar/domain": "workspace:*",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.3",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "^8.7.0",
    "handlebars": "^4.7.9",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.10",
    "mqtt": "^5.15.2",
    "nestjs-pino": "^5.0.0",
    "nodemailer": "^9.1.0",
    "pdfmake": "^0.3.11",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "^8.23.1",
    "prisma": "8.0.0-rc.12"
  }
}
