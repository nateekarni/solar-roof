    "@solar/domain": "workspace:*",
    "bullmq": "^6.3.3",
    "csv-stringify": "^6.8.3",
    "dotenv": "17.4.2",
    "exceljs": "^4.4.0",
    "express": "5.2.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
