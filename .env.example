NODE_ENV=development
DATABASE_URL=postgresql://solar:solar@localhost:5432/solar_platform
REDIS_URL=redis://localhost:6379
# Disable ingestion for web-only deployments; disable the default broker for registered external brokers only.
MQTT_ENABLED=true
MQTT_DEFAULT_BROKER_ENABLED=true
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=solar
MQTT_PASSWORD=solar
# Keep `credential` for production. `demo-anonymous` lets an approved gateway
# continue with an empty username/password and is only safe on a controlled demo network.
GATEWAY_AUTH_MODE=credential
# Stable secret used to encrypt registered broker credentials; defaults to JWT_REFRESH_SECRET when empty.
MQTT_CREDENTIAL_SECRET=
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=ap-southeast-1
STORAGE_BUCKET=solar-platform
STORAGE_ACCESS_KEY=solar
STORAGE_SECRET_KEY=change-me-storage-secret
JWT_ACCESS_SECRET=change-me-access-secret-change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me-refresh-secret
# Authenticator secret encryption: set to 64 hex characters (32 random bytes).
# Keep this private and stable across restarts while authenticators are enrolled.
TOTP_ENCRYPTION_KEY=
# Technical alert evaluation is independent of financial automation.
TECHNICAL_ALERTS_ENABLED=true
COMPARISON_WORKER_ENABLED=true
WEB_PORT=3000
API_PORT=3001
WORKER_PORT=3002
WEB_URL=http://localhost:3000

# SMTP Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Solar Platform <noreply@example.com>"
SMTP_SECURE=false
